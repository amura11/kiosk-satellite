{
  "name": "Kiosk Satellite",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "jdkDistro": "temurin" },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Tokens come from the host environment so nothing is mounted across OSes.
  //   GH_TOKEN:                  `gh auth token`
  //   CLAUDE_CODE_OAUTH_TOKEN:   `claude setup-token`
  // Set them in your shell profile / system env BEFORE launching VS Code.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "PATH": "/home/vscode/flutter/bin:${containerEnv:PATH}"
  },

  // Persists Claude Code config/login across container rebuilds.
  // ${devcontainerId} is unique per container, so no per-project slug is needed.
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  // Flutter has no devcontainer feature; pin the same version CI builds with (release.yml).
  "postCreateCommand": "[ -d ~/flutter ] || git clone --depth 1 --branch 3.44.6 https://github.com/flutter/flutter.git ~/flutter; ~/flutter/bin/flutter precache --universal && cd app && ~/flutter/bin/flutter pub get && npm ci",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "esbenp.prettier-vscode",
        "Anthropic.claude-code",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "dart.flutterSdkPath": "/home/vscode/flutter",
        "[dart]": { "editor.defaultFormatter": "Dart-Code.dart-code" }
      }
    }
  },

  "remoteUser": "vscode"
}
